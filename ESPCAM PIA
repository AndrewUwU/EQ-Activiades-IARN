#include "esp_camera.h"
#include <WiFi.h>
#include "esp_http_server.h"

// ==========================================
// DATOS DE LA RED WIFI
// ==========================================
const char* ssid = "Esp";          // Nombre de la red WiFi
const char* password = "kuhko511"; // Contraseña WiFi

// Variable para manejar el servidor HTTP
httpd_handle_t server = NULL;

// ==========================================
// DEFINICIÓN DE PINES PARA ESP32-CAM AI THINKER
// ==========================================

// Pines de control de energía y reset
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1

// Pin del reloj de la cámara
#define XCLK_GPIO_NUM      0

// Pines de comunicación SCCB (similar a I2C)
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27

// Pines de datos de la cámara
#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5

// Pines de sincronización
#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

// ==========================================
// CONFIGURACIÓN DEL STREAM DE VIDEO
// ==========================================

// Separador utilizado entre imágenes JPEG
#define PART_BOUNDARY "123456789000000000000987654321"

// Tipo de contenido enviado al navegador
static const char* _STREAM_CONTENT_TYPE =
"multipart/x-mixed-replace;boundary=" PART_BOUNDARY;

// Límite entre imágenes
static const char* _STREAM_BOUNDARY =
"\r\n--" PART_BOUNDARY "\r\n";

// Encabezado de cada imagen JPEG
static const char* _STREAM_PART =
"Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

// ==========================================
// FUNCIÓN QUE ENVÍA EL VIDEO EN TIEMPO REAL
// ==========================================
static esp_err_t stream_handler(httpd_req_t *req) {

    // Variable para almacenar el frame capturado
    camera_fb_t * fb = NULL;

    // Variable para verificar errores
    esp_err_t res = ESP_OK;

    // Tamaño del buffer JPEG
    size_t _jpg_buf_len = 0;

    // Puntero al buffer JPEG
    uint8_t * _jpg_buf = NULL;

    // Buffer para encabezados HTTP
    char * part_buf[64];

    // Configura el tipo de respuesta HTTP
    res = httpd_resp_set_type(req, _STREAM_CONTENT_TYPE);

    // Si ocurre error, termina
    if(res != ESP_OK){
        return res;
    }

    // Bucle infinito para enviar video continuamente
    while(true){

        // Captura una imagen de la cámara
        fb = esp_camera_fb_get();

        // Verifica si hubo error en la captura
        if (!fb) {

            Serial.println("Error capturando");

            res = ESP_FAIL;
        }
        else {

            // Guarda tamaño y buffer de la imagen
            _jpg_buf_len = fb->len;
            _jpg_buf = fb->buf;
        }

        // Envía encabezado HTTP de la imagen
        if(res == ESP_OK){

            size_t hlen = snprintf(
                (char *)part_buf,
                64,
                _STREAM_PART,
                _jpg_buf_len
            );

            res = httpd_resp_send_chunk(
                req,
                (const char *)part_buf,
                hlen
            );
        }

        // Envía la imagen JPEG
        if(res == ESP_OK){

            res = httpd_resp_send_chunk(
                req,
                (const char *)_jpg_buf,
                _jpg_buf_len
            );
        }

        // Envía el separador entre imágenes
        if(res == ESP_OK){

            res = httpd_resp_send_chunk(
                req,
                _STREAM_BOUNDARY,
                strlen(_STREAM_BOUNDARY)
            );
        }

        // Libera el frame de memoria
        if(fb){

            esp_camera_fb_return(fb);

            fb = NULL;
            _jpg_buf = NULL;
        }

        // Si ocurre error, sale del bucle
        if(res != ESP_OK){
            break;
        }
    }

    return res;
}

// ==========================================
// FUNCIÓN PARA INICIAR EL SERVIDOR WEB
// ==========================================
void startCameraServer() {

    // Configuración por defecto del servidor
    httpd_config_t config = HTTPD_DEFAULT_CONFIG();

    // Puerto donde trabajará el servidor
    config.server_port = 81;

    // Ruta URL para acceder al stream
    httpd_uri_t stream_uri = {

        .uri       = "/stream",
        .method    = HTTP_GET,
        .handler   = stream_handler,
        .user_ctx  = NULL
    };

    // Inicia el servidor HTTP
    if (httpd_start(&server, &config) == ESP_OK) {

        // Registra la ruta "/stream"
        httpd_register_uri_handler(server, &stream_uri);

        Serial.println("Servidor iniciado");
    }
}

// ==========================================
// FUNCIÓN SETUP
// ==========================================
void setup() {

    // Inicia comunicación serial
    Serial.begin(115200);

    // Conecta al WiFi
    WiFi.begin(ssid, password);

    // Espera hasta conectarse
    while (WiFi.status() != WL_CONNECTED) {

        delay(500);
        Serial.print(".");
    }

    Serial.println("");
    Serial.println("WiFi conectado");

    // Muestra la IP asignada
    Serial.println(WiFi.localIP());

    // Estructura de configuración de cámara
    camera_config_t config;

    // Configuración del temporizador LEDC
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;

    // Asignación de pines de datos
    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;

    // Pines de sincronización
    config.pin_xclk = XCLK_GPIO_NUM;
    config.pin_pclk = PCLK_GPIO_NUM;
    config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM;

    // Pines SCCB
    config.pin_sccb_sda = SIOD_GPIO_NUM;
    config.pin_sccb_scl = SIOC_GPIO_NUM;

    // Pines de energía y reset
    config.pin_pwdn = PWDN_GPIO_NUM;
    config.pin_reset = RESET_GPIO_NUM;

    // Frecuencia del reloj
    config.xclk_freq_hz = 20000000;

    // Formato JPEG
    config.pixel_format = PIXFORMAT_JPEG;

    // Resolución VGA = 640x480
    config.frame_size = FRAMESIZE_VGA;

    // Calidad JPEG (menor número = mejor calidad)
    config.jpeg_quality = 10;

    // Cantidad de frame buffers
    config.fb_count = 1;

    // Inicializa la cámara
    esp_err_t err = esp_camera_init(&config);

    // Verifica si hubo error
    if (err != ESP_OK) {

        Serial.printf("Error cámara: 0x%x", err);

        return;
    }

    // Obtiene acceso al sensor de cámara
    sensor_t * s = esp_camera_sensor_get();

    // Voltea imagen verticalmente
    s->set_vflip(s, 1);

    // Espeja imagen horizontalmente
    s->set_hmirror(s, 1);

    // Inicia el servidor web
    startCameraServer();
}  

