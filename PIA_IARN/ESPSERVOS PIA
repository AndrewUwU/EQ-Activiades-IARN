#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

//Credenciales para conectarse a la red
const char* ssid = "Esp";
const char* password = "kuhko511";

//Conectarse a la red
WebServer server(80);

//Identificacion de servos
Servo servo1;
Servo servo2;

// Pines
const int pinServo1 = 14;
const int pinServo2 = 13;

// ==========================================
// ACTIVAR
// ==========================================
void activarServos() {

    Serial.println("Activando servos");

    // Ambos se mueven al mismo tiempo
    servo1.write(90);
    servo2.write(90);

    delay(4000);

    // Ambos regresan al mismo tiempo
    servo1.write(0);
    servo2.write(0);

    server.send(200, "text/plain", "ACTIVADO");

    Serial.println("Finalizado");
}

// ==========================================
// SETUP
// ==========================================
void setup() {

    Serial.begin(115200);
    //Frecuencia de los servos
    servo1.setPeriodHertz(50);
    servo2.setPeriodHertz(50);
    
    servo1.attach(pinServo1, 500, 2400);
    servo2.attach(pinServo2, 500, 2400);

    // Posición inicial
    servo1.write(0);
    servo2.write(0);

    // Conexion WiFi
    WiFi.begin(ssid, password);

    while (WiFi.status() != WL_CONNECTED) {

        delay(500);
        Serial.print(".");
    }

    Serial.println("");
    Serial.println("ESP32 CONECTADO");
    Serial.println(WiFi.localIP());

    // Ruta web
    server.on("/activar", activarServos);

    server.begin();
}

// ==========================================
// LOOP
// ==========================================
void loop() {

    server.handleClient();
}
